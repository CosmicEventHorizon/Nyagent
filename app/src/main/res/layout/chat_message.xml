<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Plain text bubble used for user / tool / system messages. -->
    <TextView
        android:id="@+id/tvMessages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bubble_assistant_background"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:text="TextView"
        android:textIsSelectable="true"
        android:textSize="15sp" />

    <!-- Markdown + LaTeX bubble used for assistant responses. Spans the row so
         the WebView inside has a real width; height wraps its content. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/markdownContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bubble_assistant_background"
        android:visibility="gone" />
</FrameLayout>
